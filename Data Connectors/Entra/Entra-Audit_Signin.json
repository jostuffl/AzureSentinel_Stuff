{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Deploys the following: Data Collection Endpoint, Data Collection Rule, and the two tables EntraAuditLogs_CL and EntraSigninLogs_CL"
  },
  "parameters": {
    "workspaceResourceId": {
      "type": "string",
      "metadata": {
        "description": "Required existing workspace resource ID in the selected subscription. Tables are deployed into its own resource group."
      },
      "minLength": 1
    },
    "dataCollectionEndpointName": {
      "type": "string",
      "metadata": {
        "description": "Name for a new DCE. Ignored when reusing an existing DCE."
      },
      "minLength": 1,
      "defaultValue": "dce-entra-cribl"
    },
    "existingDataCollectionEndpointId": {
      "type": "string",
      "metadata": {
        "description": "Existing DCE resource ID, or empty to create a DCE."
      },
      "defaultValue": ""
    },
    "dataCollectionRuleName": {
      "type": "string",
      "metadata": {
        "description": "New DCR name. Do not use an existing DCR as it will be written over."
      },
      "minLength": 1,
      "defaultValue": "dcr-entra-cribl"
    },
    "createSigninTable": {
      "type": "bool",
      "metadata": {
        "description": "True only when EntraSigninLogs_CL is absent. False preserves its schema and retention."
      },
      "defaultValue": false
    },
    "createAuditTable": {
      "type": "bool",
      "metadata": {
        "description": "True only when EntraAuditLogs_CL is absent. False preserves its schema and retention."
      },
      "defaultValue": false
    },
    "publicNetworkAccess": {
      "type": "string",
      "metadata": {
        "description": "Disabled requires separately configured AMPLS, private endpoints and DNS. Enabled requires approval for public HTTPS ingestion."
      },
      "allowedValues": [
        "Disabled",
        "Enabled"
      ],
      "defaultValue": "Disabled"
    },
    "tags": {
      "type": "object",
      "metadata": {
        "description": "Tags for NEW DCE/DCR resources."
      },
      "defaultValue": {}
    }
  },
  "variables": {
    "workspaceGroup": "[split(parameters('workspaceResourceId'), '/')[4]]",
    "workspaceName": "[last(split(parameters('workspaceResourceId'), '/'))]",
    "newDceId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName'))]",
    "dceId": "[if(empty(parameters('existingDataCollectionEndpointId')), variables('newDceId'), parameters('existingDataCollectionEndpointId'))]",
    "dcrId": "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName'))]",
    "fixedTables": [
      "EntraSigninLogs_CL",
      "EntraAuditLogs_CL"
    ]
  },
