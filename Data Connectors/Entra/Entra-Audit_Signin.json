            },
            "dataCollectionEndpointName": {
              "type": "string",
              "metadata": {
                "description": "Name for a NEW  DCE. Ignored when reusing an existing DCE."
              },
              "minLength": 1,
              "defaultValue": "dce-entra-cribl"
            },
            "existingDataCollectionEndpointId": {
              "type": "string",
              "metadata": {
                "description": "Existing DCE resource ID, or empty to create a DCE. Preparation preserves an existing DCR's own DCE and overrides this selection."
              },
              "defaultValue": ""
            },
            "dataCollectionRuleName": {
              "type": "string",
              "metadata": {
                "description": "New or existing  DCR name in the deployment resource group. For EXISTING resources use the preparation script; do not overwrite directly."
              },
              "minLength": 1,
              "defaultValue": "dcr-entra-cribl"
            },
            "createSigninTable": {
              "type": "bool",
              "metadata": {
                "description": "True only when EntraSigninLogs_CL is absent. False preserves its schema and retention."
              },
              "defaultValue": false
