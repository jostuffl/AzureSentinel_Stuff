        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "workspaceResourceId": {
              "type": "string",
              "metadata": {
                "description": "Required existing workspace resource ID in the selected subscription. Tables are deployed into its own resource group."
              },
